# Copy this file to .env (which is gitignored) and fill in the real values.
# Docker Compose automatically loads .env from the project root.
#
# Never commit .env — it may contain secrets.

# Optional host port used by Docker Compose. Defaults to 8080 when omitted.
MONEY2WORD_PORT=8080

# Paste the full Application Insights connection string here.
# Find it in the Azure portal → your Application Insights resource → Overview.
# Format: InstrumentationKey=<guid>;IngestionEndpoint=https://...
ApplicationInsights__ConnectionString=InstrumentationKey=00000000-0000-0000-0000-000000000000;IngestionEndpoint=https://eastus-8.in.applicationinsights.azure.com/
