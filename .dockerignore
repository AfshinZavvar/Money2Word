# Docker builds only the web project. Keep development tooling, tests, generated
# output, and local secrets out of the build context.

# Version control and repository automation
.git/
.gitignore
.gitattributes
.github/
.azure-pipelines/

# IDE and local agent state
.vs/
.vscode/
.idea/
.claude/
.codex/
.agents/
**/*.user
**/*.suo
**/*.DotSettings.user

# .NET build, test, and coverage output
**/bin/
**/obj/
**/artifacts/
TestResults/
coverage/
coverage-*/
playwright-report/
blob-report/
test-results/
*.trx
*.coverage
*.coveragexml
*.binlog

# Projects and artifacts not used by the web-image build
Money2Word.Tests/
Money2Word.E2ETests/
mockup/
Views/
Money2Word/Properties/

# Local configuration and secrets. The example is useful to developers but is
# not consumed by the Dockerfile.
.env
.env.*
**/appsettings.Local.json
**/appsettings.*.Local.json
**/secrets.json

# Repository-only documentation and Docker orchestration files
README.md
Money2WordCore.sln
docker-compose*.yml
Dockerfile*
.dockerignore
