@{
    ViewData["Title"] = "Money to Word";
}
<div class="page-wrap">
    <header class="page-heading">
        <h1 class="card-title">Money to Word</h1>
        <p class="page-description">Dollar amounts, written in English.</p>
    </header>

    <section class="card" aria-label="Amount converter">
        <form id="converterForm" class="converter-form" novalidate>
            <label class="field-label" for="Amount">Dollar amount</label>
            <div class="entry-row">
                <div class="input-wrap">
                    <span class="currency-prefix" aria-hidden="true">$</span>
                    <input type="text" id="Amount" class="amount-input"
                           placeholder="0.00" autocomplete="off" inputmode="decimal" spellcheck="false"
                           aria-describedby="helpText responseError" />
                </div>
                <button id="btnSubmit" type="submit" class="btn-convert" aria-label="Convert amount to words">
                    <span class="btn-text">Convert to words</span>
                    <span class="btn-arrow" aria-hidden="true">&#8594;</span>
                </button>
            </div>
            <small class="help-text" id="helpText">
                $0.01 to $999,999,999,999,999.99 <span>Up to 2 decimal places</span>
            </small>
            <div id="responseError" class="error-message" aria-live="assertive" role="alert"></div>
        </form>

        <section class="output-area" aria-labelledby="resultLabel">
            <h2 id="resultLabel" class="result-label">In words</h2>
            <div class="output-content" aria-live="polite" aria-atomic="true" role="status">
                <p id="resultPlaceholder" class="result-placeholder">Your amount in words will appear here.</p>
                <div id="resultPanel" class="result-panel" style="display:none">
                    <div id="responseAmount" class="result-text"></div>
                </div>
            </div>
        </section>
    </section>
</div>
