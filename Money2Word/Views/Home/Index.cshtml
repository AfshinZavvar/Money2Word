@{
    ViewData["Title"] = "Money to Words Converter";
}
@Html.AntiForgeryToken()

<div class="container py-5">
    <div class="row d-flex justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card">
                <div class="card-header">
                    💰 Money to Words Converter
                </div>
                <div class="card-body p-4">
                    <div class="form-group mb-4">
                        <label for="Amount">Enter Money Amount:</label>
                        <input type="text" id="Amount" placeholder="e.g. 1,234.56" />
                        <small id="help" class="form-text text-muted">
                            Enter any positive amount (supports large numbers with 2 decimal places)
                        </small>
                    </div>

                    <div class="text-center">
                        <button id="btnSubmit" type="button" class="btn btn-luxury">
                            Convert
                        </button>
                    </div>

                    <div class="form-group mt-4">
                        <div id="resopnseAmount"></div>
                        <div id="responseError"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
