@model ErrorViewModel
@{
    ViewData["Title"] = "Something went wrong";
}
<section class="page-wrap card error-page">
    <h1>Something went wrong</h1>
    <p>We couldn't load this page. Return to the converter and try again.</p>
    <p><a asp-controller="Home" asp-action="Index">Return to converter</a></p>
    @if (Model.ShowRequestId)
    {
        <p class="help-text">Request ID: <code>@Model.RequestId</code></p>
    }
</section>
